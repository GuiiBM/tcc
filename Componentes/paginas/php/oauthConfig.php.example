// Apple - https://developer.apple.com (exige conta paga de desenvolvedor)
// Services ID com "Sign in with Apple"; Return URL: https://SEU-DOMINIO/callbackApple.php
define('APPLE_CLIENT_ID', '');   // Services ID, ex: com.seudominio.ressonance
define('APPLE_TEAM_ID', '');     // Team ID (10 caracteres)
define('APPLE_KEY_ID', '');      // Key ID da chave "Sign in with Apple"
define('APPLE_PRIVATE_KEY', ''); // conteúdo do arquivo AuthKey_XXXX.p8 (-----BEGIN PRIVATE KEY----- ...)
