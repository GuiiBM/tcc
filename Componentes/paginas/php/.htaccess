# Arquivos de configuração com senhas: acesso direto bloqueado.
<FilesMatch "^(dbConfig|clientId|clientSecret|adminEmails|oauthConfig|migracoes|app|loginSocial|configGoogle|adminConfig)\.php$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
